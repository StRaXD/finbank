# Copy to .env.local to override. Both are read at build time by Vite.

# Which data adapter the app composes: "mock" (default when unset or empty) or "http".
VITE_API_MODE=mock

# Base URL of the external finance API. Used only when VITE_API_MODE=http (the http adapter is a stub for now).
VITE_API_BASE_URL=
